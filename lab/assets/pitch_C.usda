#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "Materials"
    {
        def Material "GroundSurface"
        {
            token outputs:surface.connect = </Asset/Materials/GroundSurface/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.2, 0.4, 0.1)
                color3f inputs:diffuseColor.connect = </Asset/Materials/GroundSurface/Color.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.28
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @pitch_C.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Materials/GroundSurface/UV.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "Edge"
        {
            token outputs:surface.connect = </Asset/Materials/Edge/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.68, 0.67, 0.64)
                float inputs:metallic = 0
                float inputs:roughness = 0.28
                token outputs:surface
            }
        }
    }

