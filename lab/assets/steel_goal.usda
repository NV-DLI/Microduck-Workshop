#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "Materials"
    {
        def Material "PowderCoatedSteel"
        {
            token outputs:surface.connect = </Asset/Materials/PowderCoatedSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.85, 0.86)
                float inputs:metallic = 0.22
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "WovenSteel"
        {
            token outputs:surface.connect = </Asset/Materials/WovenSteel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.64, 0.68, 0.7)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }
    }

